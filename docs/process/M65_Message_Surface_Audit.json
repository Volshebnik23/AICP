    {
      "suite": "ID-IDENTITY-LC-0.1",
      "check_id": "ID-MIGRATE-01",
      "pre_m65_behavior": "No transcript-local prior-announcement requirement for AGENT_MIGRATION.aid_hash.",
      "m65_behavior": "Rejected AGENT_MIGRATION unless aid_hash matched an earlier IDENTITY_ANNOUNCE in the captured transcript.",
      "exact_normative_rfc_clause": "RFC_EXT_IDENTITY_LIFECYCLE.md sections 14.2-14.3 register AGENT_MIGRATION and require migration_id plus aid_hash; they do not require a prior same-transcript IDENTITY_ANNOUNCE.",
      "compatibility_rejection_justified": false,
      "final_action": "Removed ID-MIGRATE-01 from the suite and all evidence enforcement; retained IL-04 as a positive example."
    },
    {
      "suite": "ID-IDENTITY-LC-0.1",
      "check_id": "ID-REVOKE-01",
      "pre_m65_behavior": "Rejected later contract-changing operations signed by a kid after its KEY_REVOKE became known.",
      "m65_behavior": "Also rejected KEY_REVOKE unless its target key or AID was announced earlier in the captured transcript.",
      "exact_normative_rfc_clause": "RFC_EXT_IDENTITY_LIFECYCLE.md section 14.4 requires rejection of later contract-changing operations signed by a revoked kid; section 14.3 permits target_kid or target_aid_hash and does not require local introduction.",
      "compatibility_rejection_justified": false,
      "final_action": "Restored ID-REVOKE-01 to post-revocation contract-changing use only; retained IL-03 and IL-05."
    },
    {
      "suite": "DS-DISPUTES-0.1",
      "check_id": "DS-EVIDENCE-01",
      "pre_m65_behavior": "Required non-empty evidence_refs for CHALLENGE_ASSERTION.",
      "m65_behavior": "The second engine widened the check to CLAIM_BREACH, ARBITRATION_REQUEST, and ARBITRATION_RESULT.",
      "exact_normative_rfc_clause": "RFC_EXT_DISPUTES.md section 15.3.2 defines CHALLENGE_ASSERTION evidence_refs as MUST/non-empty, CLAIM_BREACH evidence_refs as SHOULD, and sections 15.3.5-15.3.6 define no arbitration payload relation.",
      "compatibility_rejection_justified": false,
      "final_action": "Restored the canonical CHALLENGE_ASSERTION scope."
    },
    {
      "suite": "DS-DISPUTES-0.1",
      "check_id": "DS-EVIDENCE-RESOLVE-01",
      "pre_m65_behavior": "Required a resolvable evidence reference for CHALLENGE_ASSERTION.",
      "m65_behavior": "The second engine widened resolvability rejection to CLAIM_BREACH and both arbitration messages.",
      "exact_normative_rfc_clause": "RFC_EXT_DISPUTES.md section 15.3.2 states the resolvable-reference conformance rule adjacent to CHALLENGE_ASSERTION and CLAIM_BREACH; sections 15.3.5-15.3.6 contain no arbitration payload requirements. The pre-M65 suite and canonical implementation scope this check to CHALLENGE_ASSERTION.",
      "compatibility_rejection_justified": false,
      "final_action": "Restored the canonical CHALLENGE_ASSERTION scope and its original suite description."
    },
    {
      "suite": "DS-DISPUTES-0.1",
      "check_id": "DS-ARBITRATION-01",
      "pre_m65_behavior": "No exact transcript-local challenge-to-request or request-to-result linkage rule.",
      "m65_behavior": "Required ARBITRATION_REQUEST to reference a prior local challenge and ARBITRATION_RESULT to reference a prior local request.",
      "exact_normative_rfc_clause": "RFC_EXT_DISPUTES.md sections 15.3.5-15.3.6 are headings without an exact local-linkage algorithm.",
      "compatibility_rejection_justified": false,
      "final_action": "Removed DS-ARBITRATION-01; retained DS-04 as a coherent example."
    },
    {
      "suite": "DL-DELEGATION-0.1",
      "check_id": "DL-REVOKE-01",
      "pre_m65_behavior": "No requirement that a revoked delegation be granted in the captured transcript.",
      "m65_behavior": "Rejected DELEGATION_REVOKE without a prior active local DELEGATION_GRANT.",
      "exact_normative_rfc_clause": "RFC_EXT_DELEGATION.md sections 15.2.1-15.2.2 register DELEGATION_REVOKE and require delegation_id plus effective_at; they do not require a prior same-transcript grant.",
      "compatibility_rejection_justified": false,
      "final_action": "Removed DL-REVOKE-01; retained DL-04 as a positive example."
    },
    {
      "suite": "MP-MARKETPLACE-0.1",
      "check_id": "MP-BID-01",
      "pre_m65_behavior": "Required bid messages to link to a prior RFW with coherent required offer terms.",
      "m65_behavior": "Also required BID_UPDATE/BID_WITHDRAW to reference a prior local bid, preserve its local RFW association, and never reuse a locally withdrawn bid.",
      "exact_normative_rfc_clause": "RFC_EXT_MARKETPLACE.md sections 4.2 and 9 require bid fields and bid linkage to a prior RFW; they do not define a mandatory transcript-local bid state machine.",
      "compatibility_rejection_justified": false,
      "final_action": "Restored MP-BID-01 to prior-RFW and offer-term scope; retained MP-AWARD-01 unchanged."
    },
    {
      "suite": "PA-PARTICIPANTS-0.1",
      "check_id": "PA-MEM-01",
      "pre_m65_behavior": "Gated participant traffic before acceptance and prohibited traffic after leave.",
      "m65_behavior": "Also required every PARTICIPANT_LEAVE to have a prior local join and payload.participant_id equal envelope.sender.",
      "exact_normative_rfc_clause": "RFC_EXT_PARTICIPANTS.md section 3.3 requires participant_id in the leave payload; section 4 gates participants appearing in PARTICIPANT_JOIN and prohibits later sender traffic after leave. Neither clause states the two M65 additions.",
      "compatibility_rejection_justified": false,
      "final_action": "Restored membership gating and post-leave enforcement without the M65-only leave predicates."
    },
    {
      "suite": "PE-POLICY-EVAL-0.1",
      "check_id": "PE-ATTEST-01",
      "pre_m65_behavior": "No exact mandatory POLICY_DECISION_ATTEST equality/linkage algorithm.",
      "m65_behavior": "Required an exact prior POLICY_EVAL_RESULT hash and prior local action or attestation reference.",
      "exact_normative_rfc_clause": "RFC_EXT_POLICY_EVAL.md section 12.2 says POLICY_DECISION_ATTEST MAY bind a decision to ATTEST_ACTION; it does not define the equality algorithm implemented by M65.",
      "compatibility_rejection_justified": false,
      "final_action": "Removed PE-ATTEST-01; retained reason-code, context-hash, registry, schema, and signature behavior."
    },
    {
      "suite": "DI-DELEGATED-IDENTITY-0.1",
      "check_id": "DI-REVOKE-01",
      "pre_m65_behavior": "Rejected use of ext.subject_binding_hash at or after an effective revocation.",
      "m65_behavior": "Also rejected SUBJECT_BINDING_REVOKE itself unless ISSUE appeared earlier in the captured transcript.",
      "exact_normative_rfc_clause": "RFC_EXT_DELEGATED_IDENTITY.md section 5 item 5 governs messages using ext.subject_binding_hash and their prior issue/expiry/revocation state; it does not require REVOKE itself to follow a local ISSUE.",
      "compatibility_rejection_justified": false,
      "final_action": "Restored use-at/after-revocation scope; retained signed ISSUE/REVOKE, object, issuer, expiry, and use checks."
    }
