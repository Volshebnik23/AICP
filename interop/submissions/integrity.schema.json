{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicp.dev/interop/submissions/integrity.schema.json",
  "title": "AICP Interop Submission Bundle Integrity Manifest",
  "type": "object",
  "required": [
    "submission_id",
    "manifest_version",
    "generated_at",
    "digest_alg",
    "files"
  ],
  "properties": {
    "submission_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "manifest_version": {
      "type": "string",
      "const": "1.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "digest_alg": {
      "type": "string",
      "enum": [
        "sha256"
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "digest"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/relativePath"
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\.\\./).+"
    }
  },
  "additionalProperties": false
}
