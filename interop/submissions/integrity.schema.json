{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicp.dev/interop/submissions/integrity.schema.json",
  "title": "AICP Interop Submission Bundle Integrity Manifest",
  "type": "object",
  "required": [
    "submission_id",
    "integrity_manifest_version",
    "generated_at",
    "digest_alg",
    "tracked_files"
  ],
  "properties": {
    "submission_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "integrity_manifest_version": {
      "type": "string",
      "const": "1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "digest_alg": {
      "type": "string",
      "const": "sha256"
    },
    "tracked_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "digest"
        ],
        "properties": {
          "path": {
            "$ref": "submission.schema.json#/$defs/relativePath"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
