{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicp.dev/interop/submissions/submission.schema.json",
  "title": "AICP Public Interop Submission Manifest",
  "$comment": "pairwise_interop vocabulary is reserved for examples and future migration; real pairwise submissions fail closed until a dedicated joint-execution format is implemented",
  "type": "object",
  "required": [
    "submission_id",
    "implementation_id",
    "implementation_version",
    "evidence_types",
    "evidence_status",
    "report_refs",
    "suite_refs",
    "claim_type",
    "claim_scope",
    "generated_at"
  ],
  "properties": {
    "submission_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "implementation_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "peer_implementation_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "peer_implementation_version": {
      "type": "string",
      "minLength": 1
    },
    "implementation_version": {
      "type": "string",
      "minLength": 1
    },
    "profile_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "profile_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile_id", "profile_version"],
        "properties": {
          "profile_id": { "type": "string", "minLength": 1 },
          "profile_version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "capability_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability_id", "capability_version"],
        "properties": {
          "capability_id": {
            "type": "string",
            "minLength": 1
          },
          "capability_version": {
            "type": "string",
            "pattern": "^v[0-9]+$"
          }
        }
      }
    },
    "evidence_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "conformance_report",
          "profile_report",
          "capability_report",
          "golden_transcript",
          "pairwise_transcript",
          "human_summary"
        ]
      }
    },
    "evidence_status": {
      "type": "string",
      "description": "Packaging status. pairwise is reserved and is not currently publication-eligible.",
      "enum": [
        "example",
        "template",
        "self_attested",
        "reproducible",
        "pairwise"
      ]
    },
    "report_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/relativePath"
      }
    },
    "suite_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claim_type": {
      "type": "string",
      "description": "Claim category. pairwise_interop is currently instructional/reserved and real submissions fail closed.",
      "enum": [
        "implements_profile",
        "implements_capability",
        "compatible_with_profile",
        "pairwise_interop"
      ]
    },
    "claim_scope": {
      "type": "string",
      "enum": [
        "self_attested",
        "pairwise"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    },
    "disclosures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\.\\./).+"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "claim_type": {
            "const": "implements_capability"
          }
        },
        "required": ["claim_type"]
      },
      "then": {
        "required": ["capability_refs"],
        "properties": {
          "evidence_types": {
            "contains": {
              "const": "capability_report"
            }
          }
        },
        "not": {
          "anyOf": [
            {
              "required": ["profile_ids"]
            },
            {
              "required": ["profile_refs"]
            },
            {
              "required": ["peer_implementation_id"]
            },
            {
              "required": ["peer_implementation_version"]
            }
          ]
        }
      },
      "else": {
        "required": ["profile_ids"],
        "not": {
          "required": ["capability_refs"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "claim_type": {
            "const": "pairwise_interop"
          }
        }
      },
      "then": {
        "required": [
          "peer_implementation_id",
          "peer_implementation_version"
        ],
        "properties": {
          "claim_scope": {
            "const": "pairwise"
          },
          "report_refs": {
            "minItems": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_status": {
            "const": "pairwise"
          }
        }
      },
      "then": {
        "properties": {
          "claim_type": {
            "const": "pairwise_interop"
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
