{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicp.dev/interop/submissions/submission.schema.json",
  "title": "AICP Public Interop Submission Manifest",
  "$comment": "pairwise_interop is a typed relation backed by one eligible joint report plus exact full-profile and full-binding side reports; it never creates a compatibility mark",
  "type": "object",
  "required": [
    "submission_id",
    "implementation_id",
    "implementation_version",
    "evidence_types",
    "evidence_status",
    "report_refs",
    "suite_refs",
    "claim_type",
    "claim_scope",
    "generated_at"
  ],
  "properties": {
    "submission_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "implementation_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "implementation_digest": {
      "type": "string",
      "minLength": 1,
      "not": { "const": "unknown" }
    },
    "peer_implementation_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "peer_implementation_version": {
      "type": "string",
      "minLength": 1
    },
    "peer_implementation_digest": {
      "type": "string",
      "minLength": 1,
      "not": { "const": "unknown" }
    },
    "implementation_version": {
      "type": "string",
      "minLength": 1
    },
    "profile_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "profile_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile_id", "profile_version"],
        "properties": {
          "profile_id": { "type": "string", "minLength": 1 },
          "profile_version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "capability_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability_id", "capability_version"],
        "properties": {
          "capability_id": {
            "type": "string",
            "minLength": 1
          },
          "capability_version": {
            "type": "string",
            "pattern": "^v[0-9]+$"
          }
        }
      }
    },
    "binding_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["binding_id", "binding_version"],
        "properties": {
          "binding_id": {
            "type": "string",
            "pattern": "^BIND-[A-Z0-9-]+$"
          },
          "binding_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+$"
          }
        }
      }
    },
    "evidence_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "conformance_report",
          "profile_report",
          "capability_report",
          "binding_report",
          "golden_transcript",
          "pairwise_transcript",
          "human_summary",
          "pairwise_report"
        ]
      }
    },
    "evidence_status": {
      "type": "string",
      "description": "Packaging status. pairwise is eligible only through the dedicated joint-report evaluator.",
      "enum": [
        "example",
        "template",
        "self_attested",
        "reproducible",
        "pairwise"
      ]
    },
    "report_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/relativePath"
      }
    },
    "joint_report_ref": {
      "$ref": "#/$defs/relativePath"
    },
    "suite_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claim_type": {
      "type": "string",
      "description": "Claim category. pairwise_interop records a relation between two exact builds for one registered pairwise target.",
      "enum": [
        "implements_profile",
        "implements_capability",
        "implements_binding",
        "compatible_with_profile",
        "pairwise_interop"
      ]
    },
    "claim_scope": {
      "type": "string",
      "enum": [
        "self_attested",
        "pairwise"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    },
    "disclosures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\.\\./).+"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "claim_type": {
            "const": "implements_capability"
          }
        },
        "required": ["claim_type"]
      },
      "then": {
        "required": ["capability_refs"],
        "properties": {
          "evidence_types": {
            "contains": {
              "const": "capability_report"
            }
          }
        },
        "not": {
          "anyOf": [
            {
              "required": ["profile_ids"]
            },
            {
              "required": ["profile_refs"]
            },
            {
              "required": ["binding_refs"]
            },
            {
              "required": ["peer_implementation_id"]
            },
            {
              "required": ["peer_implementation_version"]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "claim_type": {
            "const": "implements_binding"
          }
        },
        "required": ["claim_type"]
      },
      "then": {
        "required": ["binding_refs"],
        "properties": {
          "evidence_types": {
            "contains": {
              "const": "binding_report"
            }
          }
        },
        "not": {
          "anyOf": [
            { "required": ["profile_ids"] },
            { "required": ["profile_refs"] },
            { "required": ["capability_refs"] },
            { "required": ["peer_implementation_id"] },
            { "required": ["peer_implementation_version"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "claim_type": {
            "enum": ["implements_profile", "compatible_with_profile"]
          }
        },
        "required": ["claim_type"]
      },
      "then": {
        "required": ["profile_ids"],
        "not": {
          "anyOf": [
            { "required": ["capability_refs"] },
            { "required": ["binding_refs"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "claim_type": {
            "const": "pairwise_interop"
          }
        }
      },
      "then": {
        "required": [
          "peer_implementation_id",
          "peer_implementation_version"
        ],
        "properties": {
          "claim_scope": {
            "const": "pairwise"
          },
          "report_refs": {
            "minItems": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_status": {
            "const": "pairwise"
          }
        }
      },
      "then": {
        "required": [
          "implementation_digest",
          "peer_implementation_id",
          "peer_implementation_version",
          "peer_implementation_digest",
          "profile_ids",
          "profile_refs",
          "binding_refs",
          "joint_report_ref"
        ],
        "properties": {
          "claim_type": {
            "const": "pairwise_interop"
          },
          "profile_ids": {
            "prefixItems": [{ "const": "AICP-BASE" }],
            "items": false
          },
          "profile_refs": {
            "prefixItems": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["profile_id", "profile_version"],
                "properties": {
                  "profile_id": { "const": "AICP-BASE" },
                  "profile_version": { "const": "0.1" }
                }
              }
            ],
            "items": false
          },
          "binding_refs": {
            "prefixItems": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["binding_id", "binding_version"],
                "properties": {
                  "binding_id": { "const": "BIND-MCP" },
                  "binding_version": { "const": "0.1" }
                }
              }
            ],
            "items": false
          },
          "evidence_types": {
            "allOf": [
              { "contains": { "const": "profile_report" } },
              { "contains": { "const": "binding_report" } },
              { "contains": { "const": "pairwise_report" } }
            ]
          },
          "report_refs": {
            "minItems": 5,
            "maxItems": 5,
            "uniqueItems": true
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
