{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicp.dev/schemas/extensions/session-state-projection-v2.schema.json",
  "title": "AICP portable session-state projection v2 payload",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "StrictHash": {
      "type": "string",
      "pattern": "^sha256:[A-Za-z0-9_-]{43}$"
    },
    "PortableReference": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*:[^\\s]+$"
    },
    "PortableReferenceArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/PortableReference"
      }
    },
    "ProfileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_version"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "pattern": "^AICP-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
        },
        "profile_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        }
      }
    },
    "CoreContractRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch_id",
        "base_version",
        "head_version"
      ],
      "properties": {
        "branch_id": {
          "type": "string",
          "minLength": 1
        },
        "base_version": {
          "type": "string",
          "minLength": 1
        },
        "head_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "SessionStateProjectionV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projection_version",
        "session_id",
        "contract_id",
        "as_of_message_hash",
        "session_status",
        "selected_aicp_profiles",
        "profile_composition_hash",
        "accepted_negotiation_result_hash"
      ],
      "properties": {
        "projection_version": {
          "const": "aicp.session_state_projection.v2"
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "contract_id": {
          "type": "string",
          "minLength": 1
        },
        "as_of_message_hash": {
          "$ref": "#/$defs/StrictHash"
        },
        "session_status": {
          "enum": [
            "OPEN",
            "SUSPENDED",
            "CONFLICTED",
            "CLOSED",
            "UNKNOWN"
          ]
        },
        "selected_aicp_profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ProfileRef"
          }
        },
        "profile_composition_hash": {
          "$ref": "#/$defs/StrictHash"
        },
        "accepted_negotiation_result_hash": {
          "$ref": "#/$defs/StrictHash"
        },
        "active_contract_ref": {
          "$ref": "#/$defs/CoreContractRef"
        },
        "active_extensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "participant_refs": {
          "$ref": "#/$defs/PortableReferenceArray"
        },
        "policy_refs": {
          "$ref": "#/$defs/PortableReferenceArray"
        },
        "unresolved_conflict_refs": {
          "$ref": "#/$defs/PortableReferenceArray"
        },
        "authority_refs": {
          "$ref": "#/$defs/PortableReferenceArray"
        },
        "evidence_refs": {
          "$ref": "#/$defs/PortableReferenceArray"
        },
        "extension_data": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(?:x-[a-z0-9][a-z0-9._-]*|(?:vendor|org):[A-Za-z0-9][A-Za-z0-9._-]*)$"
          },
          "additionalProperties": true
        }
      }
    },
    "DeclaredBranchHead": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch_id",
        "head_version",
        "message_hash"
      ],
      "properties": {
        "branch_id": {
          "type": "string",
          "minLength": 1
        },
        "head_version": {
          "type": "string",
          "minLength": 1
        },
        "message_hash": {
          "$ref": "#/$defs/StrictHash"
        }
      }
    },
    "STATE_SYNC_RESPONSE": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "session_state",
        "session_state_hash",
        "branch_heads"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "session_state": {
          "$ref": "#/$defs/SessionStateProjectionV2"
        },
        "session_state_hash": {
          "$ref": "#/$defs/StrictHash"
        },
        "branch_heads": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/DeclaredBranchHead"
          }
        },
        "active_head_version": {
          "type": "string",
          "minLength": 1
        },
        "final_head_version": {
          "type": "string",
          "minLength": 1
        },
        "replication_hints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cursor": {
              "type": "string",
              "minLength": 1
            },
            "next_request_after_s": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
