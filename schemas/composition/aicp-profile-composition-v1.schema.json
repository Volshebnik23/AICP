{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicp.dev/schemas/composition/aicp-profile-composition-v1.schema.json",
  "title": "AICP canonical profile composition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "composition_version",
    "profiles"
  ],
  "properties": {
    "composition_version": {
      "const": "aicp.profile_composition.v1"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ProfileRef"
      }
    }
  },
  "$defs": {
    "ProfileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_version"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "pattern": "^AICP-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
        },
        "profile_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        }
      }
    }
  }
}
