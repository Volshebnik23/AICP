{
  "suite_id": "ET-EXTERNAL-TRANSACTION-0.1",
  "suite_version": "0.1.0-dev",
  "aicp_version": "0.1",
  "description": "EXT-EXTERNAL-TRANSACTION conformance checks for protocol-neutral external step declaration/result linkage, gating evidence, receipt integrity, and privacy boundaries.",
  "schema_ref": "schemas/core/aicp-core-message.schema.json",
  "payload_schema_ref": "schemas/extensions/ext-external-transaction-payloads.schema.json",
  "payload_schema_map": {
    "EXTERNAL_TX_DECLARE": "#/$defs/EXTERNAL_TX_DECLARE",
    "EXTERNAL_TX_RESULT": "#/$defs/EXTERNAL_TX_RESULT"
  },
  "transcripts": [
    {
      "id": "ET-01",
      "path": "fixtures/extensions/external_transaction/ET-01_basic_declare_result_pass.jsonl",
      "expected_message_types": ["CONTRACT_PROPOSE", "CONTRACT_ACCEPT", "EXTERNAL_TX_DECLARE", "EXTERNAL_TX_RESULT"]
    },
    {
      "id": "ET-02",
      "path": "fixtures/extensions/external_transaction/ET-02_irreversible_with_approval_pass.jsonl",
      "expected_message_types": ["CONTRACT_PROPOSE", "CONTRACT_ACCEPT", "APPROVAL_CHALLENGE", "APPROVAL_GRANT", "EXTERNAL_TX_DECLARE", "EXTERNAL_TX_RESULT"]
    },
    {
      "id": "ET-03",
      "path": "fixtures/extensions/external_transaction/ET-03_with_policy_link_pass.jsonl",
      "expected_message_types": ["CONTRACT_PROPOSE", "CONTRACT_ACCEPT", "POLICY_EVAL_REQUEST", "POLICY_EVAL_RESULT", "EXTERNAL_TX_DECLARE", "EXTERNAL_TX_RESULT"]
    },
    {
      "id": "ET-04",
      "path": "fixtures/extensions/external_transaction/ET-04_pii_ref_redaction_safe_pass.jsonl",
      "expected_message_types": ["CONTRACT_PROPOSE", "CONTRACT_ACCEPT", "EXTERNAL_TX_DECLARE", "EXTERNAL_TX_RESULT"]
    },
    {
      "id": "ET-05",
      "path": "fixtures/extensions/external_transaction/ET-05_result_without_declare_expected_fail.jsonl",
      "expected_message_types": ["CONTRACT_PROPOSE", "CONTRACT_ACCEPT", "EXTERNAL_TX_RESULT"],
      "expect_pass": false,
      "expected_failures": [{"test_id": "ET-DECLARE-LINK-01", "min_count": 1}]
    },
    {
      "id": "ET-06",
      "path": "fixtures/extensions/external_transaction/ET-06_irreversible_missing_approval_expected_fail.jsonl",
      "expected_message_types": ["CONTRACT_PROPOSE", "CONTRACT_ACCEPT", "EXTERNAL_TX_DECLARE", "EXTERNAL_TX_RESULT"],
      "expect_pass": false,
      "expected_failures": [{"test_id": "ET-IRREVERSIBLE-APPROVAL-01", "min_count": 1}]
    },
    {
      "id": "ET-07",
      "path": "fixtures/extensions/external_transaction/ET-07_policy_link_missing_expected_fail.jsonl",
      "expected_message_types": ["CONTRACT_PROPOSE", "CONTRACT_ACCEPT", "EXTERNAL_TX_DECLARE", "EXTERNAL_TX_RESULT"],
      "expect_pass": false,
      "expected_failures": [{"test_id": "ET-POLICY-LINK-01", "min_count": 1}]
    },
    {
      "id": "ET-08",
      "path": "fixtures/extensions/external_transaction/ET-08_receipt_digest_mismatch_expected_fail.jsonl",
      "expected_message_types": ["CONTRACT_PROPOSE", "CONTRACT_ACCEPT", "EXTERNAL_TX_DECLARE", "EXTERNAL_TX_RESULT"],
      "expect_pass": false,
      "expected_failures": [{"test_id": "ET-RECEIPT-DIGEST-01", "min_count": 1}]
    },
    {
      "id": "ET-09",
      "path": "fixtures/extensions/external_transaction/ET-09_inline_sensitive_receipt_expected_fail.jsonl",
      "expected_message_types": ["CONTRACT_PROPOSE", "CONTRACT_ACCEPT", "EXTERNAL_TX_DECLARE", "EXTERNAL_TX_RESULT"],
      "expect_pass": false,
      "expected_failures": [{"test_id": "ET-RECEIPT-PRIVACY-01", "min_count": 1}]
    },
    {
      "id": "ET-10",
      "path": "fixtures/extensions/external_transaction/ET-10_external_tx_id_mismatch_expected_fail.jsonl",
      "expected_message_types": ["CONTRACT_PROPOSE", "CONTRACT_ACCEPT", "EXTERNAL_TX_DECLARE", "EXTERNAL_TX_RESULT"],
      "expect_pass": false,
      "expected_failures": [{"test_id": "ET-RESULT-LINK-01", "min_count": 1}]
    }
  ],
  "checks": [
    {"test_id": "CT-SCHEMA-JSONL-01", "description": "Validate each JSONL record against Core message schema"},
    {"test_id": "CT-MESSAGE-TYPE-REGISTRY-01", "description": "message_type values must be registered in registry/message_types.json"},
    {"test_id": "CN-PAYLOAD-SCHEMA-01", "description": "Validate payload against EXT-EXTERNAL-TRANSACTION payload schema"},
    {"test_id": "CT-HASH-CHAIN-01", "description": "prev_msg_hash equals previous message_hash when present"},
    {"test_id": "CT-PREV-MSG-REQUIRED-01", "description": "For non-first transcript records, prev_msg_hash must be present and non-empty"},
    {"test_id": "CT-INVARIANTS-01", "description": "session_id is constant and message_id values are unique per transcript"},
    {"test_id": "CT-SEQUENCE-01", "description": "message_type sequence matches expected per transcript"},
    {"test_id": "CT-MESSAGE-HASH-01", "description": "recompute message_hash from message body and compare"},
    {"test_id": "ET-DECLARE-LINK-01", "description": "EXTERNAL_TX_RESULT.declared_message_hash must reference prior EXTERNAL_TX_DECLARE"},
    {"test_id": "ET-RESULT-LINK-01", "description": "EXTERNAL_TX_RESULT.external_transaction.external_tx_id must match declaration transaction id"},
    {"test_id": "ET-IRREVERSIBLE-APPROVAL-01", "description": "Irreversible external steps requiring approval must link to a prior APPROVAL_GRANT"},
    {"test_id": "ET-POLICY-LINK-01", "description": "Policy-required external steps must link to prior POLICY_EVAL_RESULT evidence"},
    {"test_id": "ET-RECEIPT-DIGEST-01", "description": "receipt digest must be structurally valid and match provided inline artifact evidence"},
    {"test_id": "ET-RECEIPT-PRIVACY-01", "description": "Receipt anchoring must avoid inline sensitive receipt fields"},
    {"test_id": "ET-PII-REF-01", "description": "pii_refs entries must follow EXT-REDACTION pii_ref structure"},
    {"test_id": "ET-CROSS-BIND-01", "description": "approval_ref and policy_eval_ref must bind to the expected prior message types"}
  ],
  "extension_id": "EXT-EXTERNAL-TRANSACTION",
  "compatibility_mark": "AICP-EXT-EXTERNAL-TRANSACTION-0.1"
}
