  "checks": [
    {"test_id": "CT-SCHEMA-JSONL-01", "description": "Validate each JSONL record against Core message schema"},
    {"test_id": "CT-MESSAGE-TYPE-REGISTRY-01", "description": "message_type values must be registered in registry/message_types.json"},
    {"test_id": "CT-HASH-CHAIN-01", "description": "prev_msg_hash equals previous message_hash when present"},
    {"test_id": "CT-PREV-MSG-REQUIRED-01", "description": "For non-first transcript records, prev_msg_hash must be present and non-empty"},
    {"test_id": "CT-INVARIANTS-01", "description": "session_id is constant and message_id values are unique per transcript"},
    {"test_id": "CT-SEQUENCE-01", "description": "message_type sequence matches expected per transcript"},
    {"test_id": "CT-MESSAGE-HASH-01", "description": "recompute message_hash from message body and compare"},
    {"test_id": "CM-CAPNEG-PROFILE-01", "description": "Commerce transcript must negotiate/select AICP-COMMERCE-ACP@0.1 via CAPNEG"},
    {"test_id": "CM-APPROVAL-REQUIRED-01", "description": "Irreversible external step must link prior approval evidence when required"},
    {"test_id": "CM-POLICY-GATE-01", "description": "Governed external step progression requires prior ALLOW policy result linkage"},
    {"test_id": "CM-ENFORCEMENT-COHERENCE-01", "description": "Enforcement verdicts must be coherent with policy/approval state and external-step result"},
    {"test_id": "CM-EXT-TX-ANCHOR-01", "description": "EXTERNAL_TX_RESULT must bind to declaration and keep external_tx_id coherent"},
    {"test_id": "CM-PII-BOUNDARY-01", "description": "Profile rejects inline sensitive receipt data; prefers pii_ref/redaction-safe handling"},
    {"test_id": "CM-ACP-MAPPING-BOUNDARY-01", "description": "ACP mapping remains informative-only: reject vendor runtime-only required fields in transcript payloads"}
  ],
