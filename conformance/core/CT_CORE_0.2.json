  "checks": [
    {
      "test_id": "CT-SCHEMA-JSONL-01",
      "description": "Validate each JSONL record against the Core v0.2 message schema"
    },
    {
      "test_id": "CT-MESSAGE-TYPE-REGISTRY-01",
      "description": "Reuse only registered Core message type IDs"
    },
    {
      "test_id": "CT-PAYLOAD-SCHEMA-01",
      "description": "Validate each lifecycle payload against Core v0.2 payload schemas"
    },
    {
      "test_id": "CT-HASH-CHAIN-01",
      "description": "Require exact previous-message hash continuity"
    },
    {
      "test_id": "CT-PREV-MSG-REQUIRED-01",
      "description": "Require prev_msg_hash after the first message"
    },
    {
      "test_id": "CT-INVARIANTS-01",
      "description": "Require one session and unique message IDs"
    },
    {
      "test_id": "CT-SEQUENCE-01",
      "description": "Match the declared deterministic fixture sequence"
    },
    {
      "test_id": "CT-SIGNATURE-HASH-01",
      "description": "Bind optional signatures to the exact message hash"
    },
    {
      "test_id": "CT-SIGNATURE-STRUCTURE-01",
      "description": "Retain optional Core signature structure validation"
    },
    {
      "test_id": "CT-MESSAGE-HASH-01",
      "description": "Recompute every message hash"
    },
    {
      "test_id": "CT2-CONTRACT-SCHEMA-01",
      "description": "Validate the versioned contract object"
    },
    {
      "test_id": "CT2-CONTRACT-ID-01",
      "description": "Require one exact contract ID across envelope, object and transcript"
    },
    {
      "test_id": "CT2-CONTRACT-HASH-01",
      "description": "Recompute object_hash('contract', contract)"
    },
    {
      "test_id": "CT2-CONTRACT-REF-01",
      "description": "Validate exact branch/base/head version-hash references"
    },
    {
      "test_id": "CT2-PROPOSAL-BINDING-01",
      "description": "Bind proposal object, hash, version and active base"
    },
    {
      "test_id": "CT2-ACCEPT-BINDING-01",
      "description": "Bind acceptance to one prior exact proposal tuple"
    },
    {
      "test_id": "CT2-ACTIVE-HEAD-01",
      "description": "Require actions and targeted errors to bind the active head"
    },
    {
      "test_id": "CT2-CONTEXT-BINDING-01",
      "description": "Limit context amendments to active-head, no-contract-effect changes"
    },
    {
      "test_id": "CT2-CONFLICT-BINDING-01",
      "description": "Validate exact CHOOSE candidates and selected head"
    },
    {
      "test_id": "CT2-AGREEMENT-STATE-01",
      "description": "Derive and verify the final exact agreement state"
    }
  ],
  "compatibility_mark": "AICP-Core-0.2"
}
