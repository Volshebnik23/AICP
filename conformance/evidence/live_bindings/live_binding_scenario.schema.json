{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicp.dev/schemas/live-binding-scenario-catalog-v1.json",
  "title": "AICP Live Binding Scenario Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_version", "target", "scenarios"],
  "properties": {
    "catalog_version": {"const": "1.0"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target_id", "target_version"],
      "properties": {
        "kind": {"const": "binding"},
        "target_id": {"enum": ["BIND-HTTP", "BIND-MCP"]},
        "target_version": {"const": "0.1"}
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/Scenario"}
    }
  },
  "$defs": {
    "Scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "tested_role",
        "semantic_family",
        "deterministic_inputs",
        "required_static_suite_checks",
        "normative_source_refs",
        "optional_feature_requirements"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "pattern": "^LIVE-(HTTP|MCP)-(SERVER|CLIENT)-[A-Z0-9-]+$"
        },
        "tested_role": {
          "enum": ["server_under_test", "client_under_test"]
        },
        "semantic_family": {"type": "string", "minLength": 1, "maxLength": 64},
        "deterministic_inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["seed"],
          "properties": {
            "seed": {"type": "integer", "minimum": 0},
            "message_fixture": {
              "type": "string",
              "pattern": "^fixtures/.+\\.(json|jsonl)$"
            },
            "session_label": {"type": "string", "minLength": 1},
            "second_session_label": {"type": "string", "minLength": 1},
            "limit": {"type": "integer", "minimum": 1, "maximum": 1000},
            "object_hash": {
              "type": "string",
              "pattern": "^sha256:[A-Za-z0-9_-]{43}$"
            },
            "channel_properties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "CP-ORDERING-0.1": {"enum": ["ordered", "unordered"]},
                "CP-RELIABILITY-0.1": {"enum": ["at_least_once", "at_most_once"]},
                "CP-ACK-0.1": {"enum": ["none", "explicit"]},
                "CP-REPLAY-WINDOW-0.1": {"type": "integer", "minimum": 0}
              }
            }
          }
        },
        "required_static_suite_checks": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "normative_source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "optional_feature_requirements": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["sse", "websocket", "wss"]}
        }
      }
    }
  }
}
