{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicp.dev/schemas/live-public-scenario-v1.json",
  "title": "AICP Public Live Scenario Control v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "target", "tested_role", "run_index", "scenarios", "input_messages"],
  "properties": {
    "protocol": {"const": "aicp.live_public_scenario.v1"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target_id", "target_version"],
      "properties": {
        "kind": {"const": "binding"},
        "target_id": {"enum": ["BIND-HTTP", "BIND-MCP"]},
        "target_version": {"const": "0.1"}
      }
    },
    "tested_role": {"enum": ["server_under_test", "client_under_test"]},
    "run_index": {"type": "integer", "minimum": 1, "maximum": 2},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_id", "semantic_operation", "optional_features"],
        "properties": {
          "scenario_id": {"type": "string", "pattern": "^LIVE-(HTTP|MCP)-(SERVER|CLIENT)-[A-Z0-9-]+$"},
          "semantic_operation": {"type": "string", "minLength": 1, "maxLength": 64},
          "optional_features": {"type": "array", "maxItems": 8, "items": {"enum": ["sse", "websocket", "wss"]}},
          "input_facts": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "limit": {"type": "integer", "minimum": 0, "maximum": 1000},
              "object_hash": {"type": "string", "maxLength": 128},
              "channel_properties": {"type": "object"}
            }
          }
        }
      }
    },
    "input_messages": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object"}}
  }
}
