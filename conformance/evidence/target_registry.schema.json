{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicp.dev/schemas/evidence-target-registry-1.1.json",
  "title": "AICP External Evidence Target Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "targets"],
  "properties": {
    "registry_version": {"const": "1.1"},
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/Target"}
    }
  },
  "$defs": {
    "Target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_key",
        "target_kind",
        "target_id",
        "target_version",
        "status",
        "catalog_path",
        "expected_mark",
        "execution_mode",
        "evidence_claim_type",
        "handler_id",
        "current_release_id",
        "required_suites",
        "required_operations"
      ],
      "properties": {
        "target_key": {
          "type": "string",
          "minLength": 3,
          "pattern": "^[^@\\s]+@[^@\\s]+$"
        },
        "target_kind": {
          "enum": ["product_profile", "capability", "binding"]
        },
        "target_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^@\\s]+$"
        },
        "target_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^@\\s]+$"
        },
        "status": {"enum": ["experimental", "stable"]},
        "catalog_path": {"$ref": "#/$defs/RelativePath"},
        "expected_mark": {"type": "string", "minLength": 1},
        "execution_mode": {
          "enum": ["full-profile", "full-capability", "full-binding"]
        },
        "evidence_claim_type": {
          "enum": [
            "implements_profile",
            "implements_capability",
            "implements_binding"
          ]
        },
        "handler_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "current_release_id": {"type": "string", "minLength": 1},
        "required_suites": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/RelativePath"}
        },
        "required_operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "describe",
              "canonicalize_hash",
              "validate_transcript",
              "generate_scenario",
              "project_session_state"
            ]
          }
        }
      }
    },
    "RelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\.\\./).+"
    }
  }
}
